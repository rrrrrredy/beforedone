{
  "name": "dsh-beforedone",
  "version": "0.1.0",
  "description": "DeepSeek Harness community Bundle for the BeforeDone evidence gate",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "LICENSE", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/protocol.test.mjs tests/process.test.mjs tests/plugin.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e:dsh": "node scripts/headless-e2e.mjs",
    "verify": "pnpm run build && pnpm run test",
    "verify:integration": "pnpm run verify && pnpm run test:integration",
    "prepack": "pnpm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrredy/beforedone.git",
    "directory": "integrations/deepseek-harness"
  },
  "homepage": "https://github.com/rrrrrredy/beforedone#deepseek-harness-community-bundle",
  "bugs": "https://github.com/rrrrrredy/beforedone/issues",
  "keywords": ["deepseek-harness", "dsh-plugin", "agent", "evidence", "completion-gate"],
  "license": "Apache-2.0"
}
